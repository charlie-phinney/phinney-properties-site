---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, sections } from '../data/site';

const hasContact = sections.includes('contact');
const nextAfterHero = sections.find((id) => id !== 'contact');
// The fallback (no form service connected yet) opens the visitor's own
// email app. The address is split so it never sits in the page as text.
const [mailUser, mailDomain] = site.contactEmail ? site.contactEmail.split('@') : ['', ''];
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base>
  <Nav />
  <main id="main" class="flex flex-col">
    <!-- Hero: always first. Photo under a deep brand wash; falls back to
         the solid brand color when no photo is set. -->
    <section class="on-deep relative isolate overflow-hidden bg-primary-deep text-bg">
      {
        site.heroImage && (
          <img
            src={site.heroImage}
            alt={site.heroImageAlt}
            class="hero-photo absolute inset-0 -z-20 h-full w-full object-cover object-[50%_45%]"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        )
      }
      <div
        class="absolute inset-0 -z-10 bg-primary-deep/75 md:bg-transparent md:bg-gradient-to-r md:from-primary-deep/95 md:via-primary-deep/80 md:to-primary-deep/10"
        aria-hidden="true"
      >
      </div>
      <div class="wrap flex min-h-[min(44rem,82svh)] flex-col justify-center py-20 sm:py-28">
        <h1 class="max-w-[15ch] text-[clamp(2.5rem,6.2vw,4.75rem)] leading-[1.04]">{site.heroHeadline}</h1>
        {site.heroSub && <p class="mt-6 max-w-[46ch] text-lg leading-relaxed text-bg/90 sm:text-xl">{site.heroSub}</p>}
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          {hasContact && <a href="#contact" class="btn btn-light">{site.heroButton}</a>}
          {
            nextAfterHero && (
              <a href={`#${nextAfterHero}`} class="btn btn-ghost px-0">
                See how we work
              </a>
            )
          }
        </div>
      </div>
    </section>

    {
      sections.map((id) => {
        if (id === 'why')
          return (
            <section id="why" class="border-b border-line">
              <h2 class="sr-only">Why {site.brand}</h2>
              <ul class="wrap grid divide-y divide-line md:grid-cols-3 md:divide-x md:divide-y-0">
                {site.why.map((w, i) => (
                  <li class="reveal py-10 md:px-10 md:py-14 md:first:pl-0 md:last:pr-0" style={`--i:${i}`}>
                    <h3 class="text-2xl leading-tight">{w.title}</h3>
                    {w.text && <p class="mt-3 max-w-[34ch] text-muted">{w.text}</p>}
                  </li>
                ))}
              </ul>
            </section>
          );

        if (id === 'about')
          return (
            <section id="about" class="py-20 sm:py-28">
              <div class="wrap grid gap-10 md:grid-cols-12 md:gap-12">
                <h2 class="reveal text-3xl leading-tight sm:text-4xl md:col-span-5">{site.aboutHeading}</h2>
                <div class="reveal space-y-5 text-lg leading-relaxed text-ink md:col-span-7" style="--i:1">
                  {site.aboutParagraphs.map((p) => (
                    <p class="max-w-[62ch]">{p}</p>
                  ))}
                  {site.aboutImage && (
                    <img
                      src={site.aboutImage}
                      alt=""
                      class="mt-8 aspect-[3/2] w-full rounded-xl object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
              </div>
            </section>
          );

        if (id === 'homes')
          return (
            <section id="homes" class="pb-20 sm:pb-28">
              <div class="wrap">
                <h2 class="reveal text-3xl leading-tight sm:text-4xl">{site.homesHeading}</h2>
                <ul class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2">
                  {site.homes.map((h, i) => (
                    <li class="reveal" style={`--i:${i % 3}`}>
                      <figure>
                        <img
                          src={h.image}
                          alt={h.caption}
                          class="aspect-[3/2] w-full rounded-xl object-cover"
                          loading="lazy"
                          decoding="async"
                        />
                        {h.caption && <figcaption class="mt-3 text-muted">{h.caption}</figcaption>}
                      </figure>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          );

        if (id === 'services')
          return (
            <section id="services" class="bg-surface py-20 sm:py-28">
              <div class="wrap">
                <h2 class="reveal text-3xl leading-tight sm:text-4xl">{site.servicesHeading}</h2>
                <dl class="mt-10 grid gap-x-12 border-t border-line sm:grid-cols-2">
                  {site.services.map((s, i) => (
                    <div class="reveal border-b border-line py-6" style={`--i:${i % 2}`}>
                      <dt class="text-xl font-semibold text-ink">{s.title}</dt>
                      {s.text && <dd class="mt-2 text-muted">{s.text}</dd>}
                    </div>
                  ))}
                </dl>
              </div>
            </section>
          );

        if (id === 'process')
          return (
            <section id="process" class="py-20 sm:py-28">
              <div class="wrap">
                <h2 class="reveal text-3xl leading-tight sm:text-4xl">{site.processHeading}</h2>
                <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-12">
                  {site.process.map((p, i) => (
                    <li class="reveal border-t-2 border-primary pt-6" style={`--i:${i}`}>
                      <span class="font-serif text-lg text-pop-deep" aria-hidden="true">
                        {pad(i + 1)}
                      </span>
                      <h3 class="mt-2 text-2xl leading-tight">{p.title}</h3>
                      {p.text && <p class="mt-3 max-w-[36ch] text-muted">{p.text}</p>}
                    </li>
                  ))}
                </ol>
              </div>
            </section>
          );

        if (id === 'area')
          return (
            <section id="area" class="on-deep bg-primary-deep py-20 text-bg sm:py-28">
              <div class="wrap grid gap-10 md:grid-cols-12 md:gap-12">
                <div class="reveal md:col-span-5">
                  <h2 class="text-3xl leading-tight sm:text-4xl">{site.areaHeading}</h2>
                  {site.areaNote && <p class="mt-4 text-bg/80">{site.areaNote}</p>}
                </div>
                <ul class="reveal grid grid-cols-2 gap-x-8 text-lg md:col-span-7" style="--i:1">
                  {site.areaPlaces.map((place) => (
                    <li class="border-b border-bg/20 py-3">{place}</li>
                  ))}
                </ul>
              </div>
            </section>
          );

        if (id === 'rentals')
          return (
            <section id="rentals" class="py-20 sm:py-28">
              <div class="wrap">
                <h2 class="reveal text-3xl leading-tight sm:text-4xl">{site.rentalsHeading}</h2>
                <ul class="mt-10 grid gap-x-8 gap-y-12 [grid-template-columns:repeat(auto-fill,minmax(min(100%,18rem),1fr))]">
                  {site.rentals.map((r, i) => {
                    const Tag = r.href ? 'a' : 'div';
                    return (
                      <li class="reveal" style={`--i:${i % 3}`}>
                        <Tag href={r.href || undefined} class="group block">
                          {r.image && (
                            <img
                              src={r.image}
                              alt=""
                              class="aspect-[4/3] w-full rounded-xl object-cover"
                              loading="lazy"
                              decoding="async"
                            />
                          )}
                          <h3 class:list={['text-xl leading-tight', r.image && 'mt-4', r.href && 'group-hover:underline']}>
                            {r.title}
                          </h3>
                          {r.price && <p class="mt-1 font-semibold text-ink">{r.price}</p>}
                          {r.details && <p class="mt-1 text-muted">{r.details}</p>}
                        </Tag>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </section>
          );

        if (id === 'contact')
          return (
            <section id="contact" class="bg-surface py-20 sm:py-28">
              <div class="wrap grid gap-10 md:grid-cols-12 md:gap-12">
                <div class="reveal md:col-span-5">
                  <h2 class="text-3xl leading-tight sm:text-4xl">{site.contactHeading}</h2>
                  {site.contactIntro && <p class="mt-4 max-w-[38ch] text-lg text-muted">{site.contactIntro}</p>}
                  {site.contactPhone && (
                    <p class="mt-6 text-lg">
                      <a href={`tel:${site.contactPhone.replace(/[^\d+]/g, '')}`} class="font-semibold text-primary underline underline-offset-4">
                        {site.contactPhone}
                      </a>
                    </p>
                  )}
                </div>

                <form
                  id="contact-form"
                  class="reveal md:col-span-7"
                  style="--i:1"
                  novalidate
                  data-endpoint={site.formEndpoint}
                  data-u={mailUser}
                  data-d={mailDomain}
                  data-brand={site.brand}
                >
                  <div class="grid gap-5 sm:grid-cols-2">
                    <div>
                      <label for="cf-name" class="mb-2 block text-sm font-semibold">Name</label>
                      <input id="cf-name" name="name" type="text" autocomplete="name" required class="field" />
                    </div>
                    <div>
                      <label for="cf-email" class="mb-2 block text-sm font-semibold">Email</label>
                      <input id="cf-email" name="email" type="email" autocomplete="email" required class="field" />
                    </div>
                    <div>
                      <label for="cf-phone" class="mb-2 block text-sm font-semibold">
                        Phone <span class="font-normal text-muted">(optional)</span>
                      </label>
                      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" class="field" />
                    </div>
                    <div>
                      <label for="cf-address" class="mb-2 block text-sm font-semibold">
                        Property address <span class="font-normal text-muted">(optional)</span>
                      </label>
                      <input id="cf-address" name="property" type="text" autocomplete="off" class="field" />
                    </div>
                    <div class="sm:col-span-2">
                      <label for="cf-message" class="mb-2 block text-sm font-semibold">How can we help?</label>
                      <textarea id="cf-message" name="message" rows="5" required class="field"></textarea>
                    </div>
                  </div>
                  <!-- Honeypot: real visitors never see or fill this. -->
                  <div class="hidden" aria-hidden="true">
                    <label for="cf-company">Company</label>
                    <input id="cf-company" name="_honey" type="text" tabindex="-1" autocomplete="off" />
                  </div>
                  <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
                    <button type="submit" class="btn btn-primary disabled:cursor-not-allowed disabled:opacity-60">
                      Send message
                    </button>
                    <p id="cf-status" role="status" aria-live="polite" class="text-base font-medium"></p>
                  </div>
                </form>
              </div>
            </section>
          );
      })
    }
  </main>
  <Footer />

  <script is:inline>
    // Reveals: opt in only when the observer exists; a 2.5s failsafe shows
    // everything if it never fires.
    (function () {
      var els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window) || !els.length) return;
      document.documentElement.classList.add('reveal-ready');
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      els.forEach(function (el) { io.observe(el); });
      setTimeout(function () {
        els.forEach(function (el) {
          var r = el.getBoundingClientRect();
          if (r.top < innerHeight) el.classList.add('in');
        });
      }, 2500);
    })();

    // Contact form.
    (function () {
      var form = document.getElementById('contact-form');
      if (!form) return;
      var status = document.getElementById('cf-status');
      var btn = form.querySelector('button[type="submit"]');
      var say = function (text, kind) {
        status.textContent = text;
        status.className = 'text-base font-medium ' + (kind === 'error' ? 'text-pop-deep' : 'text-primary');
      };
      form.addEventListener('input', function (e) {
        if (e.target.getAttribute('aria-invalid')) e.target.removeAttribute('aria-invalid');
      });
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var bad = null;
        form.querySelectorAll('[required]').forEach(function (f) {
          var ok = f.value.trim() && (f.type !== 'email' || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.value.trim()));
          if (ok) f.removeAttribute('aria-invalid');
          else { f.setAttribute('aria-invalid', 'true'); bad = bad || f; }
        });
        if (bad) { say('Please add your name, email and a short message.', 'error'); bad.focus(); return; }
        var data = Object.fromEntries(new FormData(form).entries());
        if (data._honey) { say('Thanks. Your message is on its way.'); form.reset(); return; }
        delete data._honey;

        var endpoint = form.dataset.endpoint;
        if (!endpoint) {
          // No form service connected: hand the note to the visitor's email app.
          var to = form.dataset.u && form.dataset.d ? form.dataset.u + '@' + form.dataset.d : '';
          if (!to) { say('Sorry, the form is not set up yet.', 'error'); return; }
          var body = data.message + '\n\n' + data.name + '\n' + data.email +
            (data.phone ? '\n' + data.phone : '') + (data.property ? '\nProperty: ' + data.property : '');
          location.href = 'mailto:' + to + '?subject=' + encodeURIComponent('Inquiry for ' + form.dataset.brand) +
            '&body=' + encodeURIComponent(body);
          say('Your email app should open with the note ready to send.');
          return;
        }

        btn.disabled = true;
        say('Sending…');
        data._subject = 'New inquiry from ' + data.name + ' (' + form.dataset.brand + ' website)';
        fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        })
          .then(function (r) { if (!r.ok) throw new Error(String(r.status)); return r.json().catch(function () { return {}; }); })
          .then(function () { form.reset(); say('Thanks. Your message is on its way.'); })
          .catch(function () { say('That did not send. Please try again in a minute.', 'error'); })
          .finally(function () { btn.disabled = false; });
      });
    })();
  </script>
</Base>
